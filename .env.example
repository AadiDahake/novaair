# NovaAir environment. Copy to .env.local and fill in the values.
# Names and descriptions only. Never commit a value.

# --- Storage -----------------------------------------------------------------
# The Supabase project URL, for example https://abcdefgh.supabase.co.
# When this and the service role key are both absent, the site runs on an in-memory
# store seeded by the same seed function, so `npm run dev` works with no credentials.
SUPABASE_URL=
# The Supabase service role key. Server only. It must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The direct Postgres connection string for the same project. Used only by the
# migrate, seed and reset scripts, never by the running site.
SUPABASE_DB_URL=

# --- Analytics ---------------------------------------------------------------
# The PostHog project API key. When it is absent, PostHog never starts.
NEXT_PUBLIC_POSTHOG_KEY=
# The PostHog ingestion host, for example https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
# The PostHog private API host, for example https://us.posthog.com. The seeding and verification
# scripts read it. It is a different host from the ingestion one.
POSTHOG_HOST=
# The numeric PostHog project id, from the project settings page.
POSTHOG_PROJECT_ID=
# A PostHog personal API key, with the Query Read and Session Recording Read scopes.
# Server only. It must never reach the browser.
POSTHOG_PERSONAL_API_KEY=

# --- Patchlet widget ---------------------------------------------------------
# The URL of the Patchlet widget script. The script tag renders only when this and
# the key are both set.
NEXT_PUBLIC_PATCHLET_WIDGET_URL=
# The Patchlet public key, sent as the script tag's data-key attribute.
NEXT_PUBLIC_PATCHLET_KEY=

# --- Scripts -----------------------------------------------------------------
# The site the scripts talk to: the reset script, and the browser that records the PostHog
# sessions. Defaults to http://localhost:3000 for the reset script and http://localhost:4100 for
# the session seeder.
NOVAAIR_BASE_URL=
# The booking the session seeder looks up. Both default to the demo reservation in
# lib/seats/demo-data.ts, so a rename of the demo party needs no change here.
NOVAAIR_DEMO_CODE=
NOVAAIR_DEMO_LAST_NAME=
